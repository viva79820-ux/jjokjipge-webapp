{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/expire-reservations",
      "schedule": "0 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jjokjipge-webapp.vercel.app" }],
      "destination": "https://angelsaju.com/$1",
      "permanent": true
    }
  ]
}
